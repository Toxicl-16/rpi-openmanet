#!/bin/sh /etc/rc.common

USE_PROCD=1
# The Morse board configuration can create wireless/network UCI after the
# earliest init scripts have run. Start after those generators; the iface
# hotplug hook also repairs the topology when ahwlan first comes up.
START=99

start_service() {
	[ -x /usr/sbin/openmanet-batman ] || return 0
	/usr/sbin/openmanet-batman repair
}

reload_service() {
	[ -x /usr/sbin/openmanet-batman ] || return 0
	/usr/sbin/openmanet-batman repair reload
}

service_triggers() {
	procd_add_reload_trigger network wireless mesh11sd
}
