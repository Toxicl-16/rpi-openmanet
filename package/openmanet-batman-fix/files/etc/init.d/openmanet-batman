#!/bin/sh /etc/rc.common

USE_PROCD=1
START=12

start_service() {
	[ -x /usr/sbin/openmanet-batman ] || return 0
	/usr/sbin/openmanet-batman repair
}

reload_service() {
	[ -x /usr/sbin/openmanet-batman ] || return 0
	/usr/sbin/openmanet-batman repair reload
}

service_triggers() {
	procd_add_reload_trigger network wireless mesh11sd
}
