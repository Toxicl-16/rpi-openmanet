#!/bin/sh

# Normalize the topology produced by the OpenMANET 802.11s wizard before
# netifd starts. The physical mesh interface must be a BATMAN hard interface;
# putting wlanX directly on br-ahwlan bypasses batman-adv.

. /lib/functions.sh

set -u

log_msg() {
	logger -t openmanet-batman "$*" 2>/dev/null || true
	echo "openmanet-batman: $*"
}

find_mesh_iface() {
	local section="$1" mode disabled device
	config_get mode "$section" mode
	config_get_bool disabled "$section" disabled 0
	config_get device "$section" device
	[ "$mode" = mesh ] || return 0
	[ "$disabled" -eq 0 ] || return 0
	[ -n "$device" ] || return 0
	mesh_iface_sections="${mesh_iface_sections} ${section}"
}

find_ahwlan_bridge() {
	local section="$1" type name
	config_get type "$section" type
	config_get name "$section" name
	[ "$type" = bridge ] || return 0
	[ "$name" = br-ahwlan ] || return 0
	ahwlan_bridge="$section"
}

ensure_bridge_port() {
	local section="$1"
	local ports
	[ -n "$section" ] || return 0
	ports="$(uci -q get network."$section".ports 2>/dev/null || true)"
	case " $ports " in
		*" bat0 "*) ;;
		*) uci add_list network."$section".ports='bat0' ;;
	esac
}

repair() {
	local iface index hardif gate

	mesh_iface_sections=""
	config_load wireless
	config_foreach find_mesh_iface wifi-iface
	[ -n "$mesh_iface_sections" ] || {
		log_msg 'no enabled 802.11s mesh interface found; leaving network unchanged'
		return 0
	}

	uci set network.bat0='interface'
	uci set network.bat0.proto='batadv'
	uci set network.bat0.routing_algo='BATMAN_V'
	uci set network.bat0.multicast_mode='0'
	uci set network.bat0.bridge_loop_avoidance='1'

	gate="$(uci -q get mesh11sd.mesh_params.mesh_gate_announcements 2>/dev/null || true)"
	case "$gate" in
		0) uci set network.bat0.gw_mode='client' ;;
		1) uci set network.bat0.gw_mode='server' ;;
		*) uci -q delete network.bat0.gw_mode || true ;;
	esac

	index=0
	for iface in $mesh_iface_sections; do
		hardif="batmesh${index}"
		uci set network."$hardif"='interface'
		uci set network."$hardif".proto='batadv_hardif'
		uci set network."$hardif".master='bat0'
		uci set wireless."$iface".network="$hardif"
		uci set wireless."$iface".mesh_fwding='0'
		index=$((index + 1))
	done

	# Keep the existing ahwlan bridge and its existing ports. Only add bat0;
	# never move the Pi 5 gateway Ethernet uplink into this bridge.
	ahwlan_bridge=""
	config_load network
	config_foreach find_ahwlan_bridge device
	if [ -z "$ahwlan_bridge" ] && uci -q get network.ahwlan >/dev/null 2>&1; then
		ahwlan_bridge='ahwlan_dev'
		uci set network."$ahwlan_bridge"='device'
		uci set network."$ahwlan_bridge".type='bridge'
		uci set network."$ahwlan_bridge".name='br-ahwlan'
		uci set network.ahwlan.device='br-ahwlan'
	fi
	ensure_bridge_port "$ahwlan_bridge"

	uci -q set mesh11sd.mesh_params.mesh_fwding='0' || true
	uci commit network
	uci commit wireless
	uci commit mesh11sd 2>/dev/null || true
	log_msg "BATMAN-V topology repaired (${index} mesh hard interface(s))"
}

case "${1:-repair}" in
	repair) repair ;;
	*) echo "usage: $0 repair" >&2; exit 2 ;;
esac
