#!/bin/sh /etc/rc.common

START=97
USE_PROCD=1

DATA_ROOT=/opt/golangtakserver
SERVER=/usr/bin/golangtakserver

start_service() {
	[ -x "$SERVER" ] || return 0
	mkdir -p "$DATA_ROOT"
	chmod 0700 "$DATA_ROOT"

	procd_open_instance
	procd_set_param command "$SERVER" run --service --data "$DATA_ROOT"
	procd_set_param respawn 3600 5 5
	procd_set_param stdout 1
	procd_set_param stderr 1
	procd_close_instance
}

stop_service() {
	return 0
}
