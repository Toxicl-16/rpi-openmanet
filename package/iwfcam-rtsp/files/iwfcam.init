#!/bin/sh /etc/rc.common

START=96
USE_PROCD=1

BIN=/usr/bin/iwfcam-rtsp
WAIT_BIN=/usr/sbin/iwfcam-wait

load_config() {
	config_load iwfcam
	config_get CAMERA_IP main camera_ip 10.41.0.101
	config_get CAMERA_MAC main camera_mac ''
	config_get RTSP_PORT main rtsp_port 8554
	config_get ENABLED main enabled 1
}

start_service() {
	load_config
	[ "$ENABLED" = "0" ] && return 0
	[ -x "$BIN" ] || return 0
	[ -x "$WAIT_BIN" ] || return 0

	procd_open_instance
	procd_set_param command "$WAIT_BIN" "$CAMERA_IP" "$CAMERA_MAC" "$BIN" "$RTSP_PORT"
	procd_set_param respawn 3600 5 5
	procd_set_param stdout 1
	procd_set_param stderr 1
	procd_close_instance
}

service_triggers() {
	procd_add_reload_trigger network wireless iwfcam
}
