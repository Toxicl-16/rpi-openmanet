+// splitAnnexB converts the camera's H.264 byte stream into individual NALUs
+// for the RTP packetizer. It accepts both three- and four-byte start codes.
+func splitAnnexB(buf []byte) [][]byte {
+	var starts []int
+	for i := 0; i+3 <= len(buf); {
+		if i+4 <= len(buf) && buf[i] == 0 && buf[i+1] == 0 && buf[i+2] == 0 && buf[i+3] == 1 {
+			starts = append(starts, i)
+			i += 4
+			continue
+		}
+		if buf[i] == 0 && buf[i+1] == 0 && buf[i+2] == 1 {
+			starts = append(starts, i)
+			i += 3
+			continue
+		}
+		i++
+	}
+	if len(starts) == 0 {
+		if len(buf) > 0 {
+			return [][]byte{buf}
+		}
+		return nil
+	}
+
+	var nalus [][]byte
+	for i, start := range starts {
+		naluStart := start + 3
+		if start+4 <= len(buf) && buf[start+2] == 0 {
+			naluStart = start + 4
+		}
+		naluEnd := len(buf)
+		if i+1 < len(starts) {
+			naluEnd = starts[i+1]
+		}
+		if naluStart < naluEnd {
+			nalus = append(nalus, buf[naluStart:naluEnd])
+		}
+	}
+	return nalus
+}
